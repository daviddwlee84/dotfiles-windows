#!/usr/bin/env pwsh
# chezmoi modify_ script: enforce only Codex's native footer while preserving
# every unrelated live setting (providers, projects, plugins, feature flags).
# Runs under [interpreters.ps1]. Every failure emits the original stdin bytes
# unchanged: config recovery must be explicit, never an accidental overwrite.

$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $false

function Write-StdoutBytes {
    param(
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [byte[]] $Bytes
    )

    $out = [Console]::OpenStandardOutput()
    $out.Write($Bytes, 0, $Bytes.Length)
    $out.Flush()
}

function Write-PreservedInput {
    param(
        [Parameter(Mandatory)]
        [string] $Message,

        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [byte[]] $Bytes
    )

    [Console]::Error.WriteLine("modify_config.toml: $Message; preserving live config unchanged")
    Write-StdoutBytes -Bytes $Bytes
}

function Test-StartsWithUtf8Bom {
    param(
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [byte[]] $Bytes
    )

    return $Bytes.Length -ge 3 -and
        $Bytes[0] -eq 0xEF -and
        $Bytes[1] -eq 0xBB -and
        $Bytes[2] -eq 0xBF
}

$inputBuffer = [System.IO.MemoryStream]::new()
try {
    try {
        [Console]::OpenStandardInput().CopyTo($inputBuffer)
        [byte[]] $originalBytes = $inputBuffer.ToArray()
    } catch {
        [byte[]] $originalBytes = $inputBuffer.ToArray()
        Write-PreservedInput -Message "could not read stdin bytes: $($_.Exception.Message)" -Bytes $originalBytes
        return
    }
} finally {
    $inputBuffer.Dispose()
}

# Keep the original byte array immutable. Parsing gets a copy with at most one
# leading UTF-8 BOM removed; successful output is always newly encoded instead.
[byte[]] $parseBytes = [byte[]]::new($originalBytes.Length)
[System.Array]::Copy($originalBytes, $parseBytes, $originalBytes.Length)
$removedBom = Test-StartsWithUtf8Bom -Bytes $parseBytes
if ($removedBom) {
    [byte[]] $withoutBom = [byte[]]::new($parseBytes.Length - 3)
    if ($withoutBom.Length -gt 0) {
        [System.Array]::Copy($parseBytes, 3, $withoutBom, 0, $withoutBom.Length)
    }
    $parseBytes = $withoutBom
}

if ($removedBom -and (Test-StartsWithUtf8Bom -Bytes $parseBytes)) {
    Write-PreservedInput -Message 'multiple leading UTF-8 BOMs are not valid TOML' -Bytes $originalBytes
    return
}

$strictUtf8 = [System.Text.UTF8Encoding]::new($false, $true)
try {
    $liveText = $strictUtf8.GetString($parseBytes)
} catch [System.Text.DecoderFallbackException] {
    Write-PreservedInput -Message "stdin is not valid UTF-8: $($_.Exception.Message)" -Bytes $originalBytes
    return
}

# An older text-mode modifier could decode a UTF-8 BOM through the Windows OEM
# code page and write the mojibake back. Two observed forms are the direct OEM
# rendering and that rendering encoded/decoded once more. They are unambiguous at
# byte zero and are not legal TOML key prefixes, so repair exactly these known
# signatures; every unknown malformed prefix remains fail-closed below.
$mojibakeBom = @( ([string]([char]0x2229) + [char]0x2557 + [char]0x2510), 'Γê⌐ΓòùΓöÉ' )
foreach ($prefix in $mojibakeBom) {
    if ($liveText.StartsWith($prefix, [System.StringComparison]::Ordinal)) {
        [Console]::Error.WriteLine('modify_config.toml: repairing a mojibake UTF-8 BOM prefix from an older modifier')
        $liveText = $liveText.Substring($prefix.Length)
        $parseBytes = $strictUtf8.GetBytes($liveText)
        break
    }
}

# Some TOML parsers accept a lone CR in comments or multiline strings even though
# TOML permits newlines only as LF or CRLF. Reject it before a parser can turn
# malformed input into a successful, semantically changed merge.
if ($liveText -match "`r(?!`n)") {
    Write-PreservedInput -Message 'stdin contains a standalone CR that TOML does not permit' -Bytes $originalBytes
    return
}

# TOML permits space, tab, LF, and CRLF as blank input. Do not let PowerShell's
# broader Unicode whitespace definition turn NBSP, a lone CR, or similar bytes
# into a fresh config silently; the parser must never be bypassed for those inputs.
$legalBlank = [System.Text.RegularExpressions.Regex]::IsMatch(
    $liveText,
    '\A(?:[ \t]|\n|\r\n)*\z',
    [System.Text.RegularExpressions.RegexOptions]::CultureInvariant
)
if (-not $legalBlank -and [string]::IsNullOrWhiteSpace($liveText)) {
    Write-PreservedInput -Message 'stdin contains whitespace that TOML does not allow as blank input' -Bytes $originalBytes
    return
}

$bun = Get-Command bun -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
if (-not $bun) {
    Write-PreservedInput -Message 'bun was not found; the offline TOML parser is unavailable' -Bytes $originalBytes
    return
}

$utf8 = [System.Text.UTF8Encoding]::new($false)
$overlayText = @'
{{ include (joinPath .chezmoi.sourceDir ".chezmoitemplates/agents/codex.config.overlay.toml") }}
'@

$tmpDir = [System.IO.Path]::GetTempPath()
$stamp = [System.IO.Path]::GetRandomFileName()
$overlayFile = Join-Path $tmpDir "codex-overlay-$stamp.toml"
$liveFile = Join-Path $tmpDir "codex-live-$stamp.toml"
$jsFile = Join-Path $tmpDir "codex-merge-$stamp.js"
$outFile = Join-Path $tmpDir "codex-out-$stamp.toml"

try {
    [System.IO.File]::WriteAllBytes($overlayFile, $utf8.GetBytes($overlayText))
    [System.IO.File]::WriteAllBytes($liveFile, $parseBytes)

        $jsSource = @'
import { readFileSync, writeFileSync } from "node:fs";

const [, , overlayPath, livePath, outPath] = process.argv;
const normalize = (text) => text.replace(/\r\n/g, "\n").replace(/\r/g, "\n");

let statusLine;
try {
    const overlay = Bun.TOML.parse(readFileSync(overlayPath, "utf8"));
    statusLine = overlay?.tui?.status_line;
    if (!Array.isArray(statusLine) || !statusLine.every((item) => typeof item === "string")) {
        throw new Error("tui.status_line is not an array of strings");
    }
} catch (error) {
    console.error(`modify_config.toml: managed overlay is invalid: ${error.message}`);
    process.exit(11);
}

let liveText = normalize(readFileSync(livePath, "utf8"));
let live;
try {
    live = Bun.TOML.parse(liveText);
} catch (error) {
    console.error(`modify_config.toml: live config is invalid TOML: ${error.message}`);
    process.exit(12);
}

if (Object.hasOwn(live, "tui") && (live.tui === null || Array.isArray(live.tui) || typeof live.tui !== "object")) {
    console.error("modify_config.toml: live tui value is not a table; refusing a lossy replacement");
    process.exit(14);
}

// Find a direct [tui] header or its direct status_line assignment without ever
// interpreting lookalike text inside TOML strings/comments. Bun validates the
// complete document first; this scanner only locates the raw range to replace,
// which preserves every unrelated byte and comment.
function lineState(text, callback) {
    let mode = "normal";
    let triple = false;
    let escaped = false;
    let lineStart = 0;

    for (let i = 0; i <= text.length; i += 1) {
        const ch = text[i] ?? "\n";
        const atLineStart = i === lineStart;
        if (atLineStart && mode === "normal") {
            const newline = text.indexOf("\n", i);
            const lineEnd = newline === -1 ? text.length : newline;
            const result = callback(text.slice(i, lineEnd), i, lineEnd, newline === -1 ? text.length : newline + 1);
            if (result) return result;
        }

        if (mode === "comment") {
            if (ch === "\n") mode = "normal";
        } else if (mode === "basic") {
            if (triple && text.startsWith('"""', i) && !escaped) {
                mode = "normal";
                triple = false;
                i += 2;
            } else if (!triple && ch === '"' && !escaped) {
                mode = "normal";
            }
            if (ch === "\\" && !escaped) escaped = true;
            else escaped = false;
        } else if (mode === "literal") {
            if (triple && text.startsWith("'''", i)) {
                mode = "normal";
                triple = false;
                i += 2;
            } else if (!triple && ch === "'") {
                mode = "normal";
            }
        } else if (ch === "#") {
            mode = "comment";
        } else if (text.startsWith('"""', i)) {
            mode = "basic";
            triple = true;
            escaped = false;
            i += 2;
        } else if (text.startsWith("'''", i)) {
            mode = "literal";
            triple = true;
            i += 2;
        } else if (ch === '"') {
            mode = "basic";
            triple = false;
            escaped = false;
        } else if (ch === "'") {
            mode = "literal";
            triple = false;
        }

        if (ch === "\n") lineStart = i + 1;
    }
    return null;
}

function assignmentEnd(text, equalsAt) {
    let square = 0;
    let curly = 0;
    let mode = "normal";
    let triple = false;
    let escaped = false;

    for (let i = equalsAt + 1; i < text.length; i += 1) {
        const ch = text[i];
        if (mode === "comment") {
            if (ch === "\n") {
                mode = "normal";
                if (square === 0 && curly === 0) return i + 1;
            }
            continue;
        }
        if (mode === "basic") {
            if (triple && text.startsWith('"""', i) && !escaped) {
                mode = "normal";
                triple = false;
                i += 2;
            } else if (!triple && ch === '"' && !escaped) mode = "normal";
            if (ch === "\\" && !escaped) escaped = true;
            else escaped = false;
            continue;
        }
        if (mode === "literal") {
            if (triple && text.startsWith("'''", i)) {
                mode = "normal";
                triple = false;
                i += 2;
            } else if (!triple && ch === "'") mode = "normal";
            continue;
        }
        if (ch === "#") mode = "comment";
        else if (text.startsWith('"""', i)) {
            mode = "basic";
            triple = true;
            escaped = false;
            i += 2;
        } else if (text.startsWith("'''", i)) {
            mode = "literal";
            triple = true;
            i += 2;
        } else if (ch === '"') {
            mode = "basic";
            triple = false;
            escaped = false;
        } else if (ch === "'") {
            mode = "literal";
            triple = false;
        } else if (ch === "[") square += 1;
        else if (ch === "]") square -= 1;
        else if (ch === "{") curly += 1;
        else if (ch === "}") curly -= 1;
        else if (ch === "\n" && square === 0 && curly === 0) return i + 1;
    }
    return text.length;
}

let inTui = false;
let tuiInsertAt = null;
const found = lineState(liveText, (line, start, lineEnd, nextLine) => {
    if (/^\s*\[\s*tui\s*\]\s*(?:#.*)?$/.test(line)) {
        inTui = true;
        tuiInsertAt = nextLine;
        return null;
    }
    if (/^\s*\[/.test(line)) inTui = false;
    const direct = inTui ? /^\s*status_line\s*=/.exec(line) : null;
    const dotted = tuiInsertAt === null ? /^\s*tui\.status_line\s*=/.exec(line) : null;
    const match = direct ?? dotted;
    if (!match) return null;
    const equalsAt = start + line.indexOf("=", match.index);
    return { start, end: assignmentEnd(liveText, equalsAt), dotted: Boolean(dotted) };
});

const arrayBody = statusLine.map((item) => `  ${JSON.stringify(item)},`).join("\n");
const assignment = `status_line = [\n${arrayBody}\n]\n`;
if (found) {
    const replacement = found.dotted ? `tui.${assignment}` : assignment;
    liveText = liveText.slice(0, found.start) + replacement + liveText.slice(found.end);
} else if (tuiInsertAt !== null) {
    liveText = liveText.slice(0, tuiInsertAt) + assignment + liveText.slice(tuiInsertAt);
} else {
    liveText = liveText.replace(/\n*$/, "\n");
    liveText += `\n[tui]\n${assignment}`;
}

liveText = liveText.replace(/\n*$/, "\n");
try {
    const output = Bun.TOML.parse(liveText);
    if (JSON.stringify(output?.tui?.status_line) !== JSON.stringify(statusLine)) {
        throw new Error("merged tui.status_line did not match the managed value");
    }
} catch (error) {
    console.error(`modify_config.toml: could not merge managed status line: ${error.message}`);
    process.exit(13);
}

writeFileSync(outPath, liveText, "utf8");
'@
        [System.IO.File]::WriteAllText($jsFile, $jsSource, $utf8)

        & $bun.Source $jsFile $overlayFile $liveFile $outFile 1>$null
    $rc = $LASTEXITCODE

    if ($rc -ne 0 -or -not (Test-Path -LiteralPath $outFile -PathType Leaf)) {
                Write-PreservedInput -Message "offline TOML merge failed (exit $rc)" -Bytes $originalBytes
        return
    }

    Write-StdoutBytes -Bytes ([System.IO.File]::ReadAllBytes($outFile))
} catch {
    Write-PreservedInput -Message "unexpected merge failure: $($_.Exception.Message)" -Bytes $originalBytes
} finally {
    foreach ($file in $overlayFile, $liveFile, $jsFile, $outFile) {
        try { [System.IO.File]::Delete($file) } catch { $null = $_ }
    }
}
