{{- $herdrDir := printf "%s/.config/herdr" (.chezmoi.homeDir | replace "\\" "/") -}}
# herdr-plus Quick Action — translate the focused pane into a language you type.
# Managed by chezmoi. The form field becomes {{"{{"}}.Value{{"}}"}} and is passed as --to, which
# translate resolves fuzzily ("chinees" -> zh). Without it the target comes from
# translate's own [general] config (or $HERDR_TRANSLATE_TO).
# See docs/translate.md § "Translate a herdr pane".
name = "Translate pane into…"
description = "Same as Translate pane, but pick the target language"
type = "form"
command = 'pwsh -NoProfile -File "{{ $herdrDir }}/pane-translate.ps1" visible "$HERDR_PLUS_PANE_ID" --to "{{"{{"}}.Value{{"}}"}}"'

[form]
prompt = "Translate this pane into"
placeholder = "e.g. zh-TW, en, japanese"
