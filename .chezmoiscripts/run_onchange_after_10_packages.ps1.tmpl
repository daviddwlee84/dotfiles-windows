    Write-Warning "This is a run_onchange script; an unchanged apply will not retry it."
    Write-Warning "Retry only this installer with: chezmoi state delete --bucket=entryState --key='C:/Users/{{ .chezmoi.username }}/.chezmoiscripts/10_packages.ps1'; chezmoi apply"
} else {
    Info 'package install complete — no failures'
}
