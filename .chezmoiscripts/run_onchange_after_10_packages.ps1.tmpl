{{ if .installTranslate -}}
# translate -- terminal translator CLI+TUI (github.com/daviddwlee84/translate).
# Installed from the author's own scoop bucket. Since 2026-08 that repo's release
# workflow cross-compiles windows/{amd64,arm64} on every tag and GoReleaser pushes
# the manifest here, so this is now a seconds-long download of a prebuilt binary.
#
# It used to be `go install` from source: no manifest and no prebuilt Windows
# artifact existed, so a fresh box spent several minutes compiling (embedded
# swagger-ui + sqlite) and needed a whole Go toolchain for one CLI. That is also
# why this block used to `Scoop-Install @('go')` unconditionally; it no longer
# does. The optional Herdr stack still source-builds dev-cli + herdr-plus and
# therefore installs Go itself; the experimental SpecStory build skips cleanly
# when Go is absent unless Extra runtimes is enabled.
#
# Upgrades are `scoop update translate` (see `just upgrade-translate`); there is
# no version pin to bump here any more.
scoop bucket add daviddwlee84 https://github.com/daviddwlee84/scoop-bucket *> $null
Scoop-Install @('daviddwlee84/translate')

# Migration off the go-install era: that path put translate.exe in ~\.local\bin,
# which precedes ~\scoop\shims on PATH. A leftover copy therefore shadows the
# scoop one permanently -- `scoop update translate` reports success while
# `translate --version` keeps printing the old build. Drop it, but only once the
# shim is genuinely in place, so a failed scoop install never leaves the box with
# no translate at all.
$trOld = Join-Path $HOME '.local\bin\translate.exe'
if (Test-Path -LiteralPath $trOld) {
    $scoopRoot = if ($env:SCOOP) { $env:SCOOP } else { Join-Path $HOME 'scoop' }
    if (Test-Path -LiteralPath (Join-Path $scoopRoot 'shims\translate.exe')) {
        Info 'removing stale ~\.local\bin\translate.exe (it shadows the scoop shim)'
        Remove-Item -LiteralPath $trOld -Force -ErrorAction SilentlyContinue
    } else {
        Info 'translate: keeping ~\.local\bin\translate.exe until the scoop shim exists'
    }
}
{{ end -}}

