#Requires -Version 7
$ErrorActionPreference = 'Continue'
if (Test-Path variable:PSNativeCommandUseErrorActionPreference) { $PSNativeCommandUseErrorActionPreference = $false }

{{- if .installCodingAgents }}
{{ include "scripts/codex-hooks-merge.ps1" }}
try {
    $enablePeon = {{ if or (eq .agentSounds "peon") (eq .agentSounds "both") }}$true{{ else }}$false{{ end }}
    [void](Sync-CodexHooks -EnablePeon $enablePeon)
} catch {
    Write-Warning "Codex hook convergence failed; keeping existing configuration: $_"
}
{{- end }}

exit 0
