#Requires -Version 7
# run_onchange_after_25_claude_settings.ps1 — merge managed overlays into
# ~/.claude/settings.json and ~/.claude/plugins/claude-hud/config.json.
# Companion to the parent (macOS/Linux) repo's dot_claude/modify_settings.json;
# that repo uses a `modify_` + jq merge, which is unreliable on Windows
# (invariant #5), so we use the editor-overlay run_onchange pwsh idiom instead.
#
# Why merges (not managed files)? Claude Code rewrites settings.json at runtime,
# and /claude-hud:configure rewrites the HUD config. Static managed files would
# clobber live-only state. Each transaction recursively merges only our owned
# leaves and fails closed independently, so one malformed file cannot block the
# other or be overwritten.
#
# Gated on installCodingAgents. Re-runs when either embedded overlay changes.
{{ if .installCodingAgents -}}
$ErrorActionPreference = 'Continue'   # best-effort; never abort the apply

# Embedded from chezmoi-ignored claude/ sources. Embedding makes this script
# self-contained and includes both overlays in the run_onchange content hash.
$settingsOverlayJson = @'
{{ include "claude/settings-overlay.json" }}
'@
$hudOverlayJson = @'
{{ include "claude/hud-full-overlay.json" }}
'@

# Parse a JSON string as an object. Arrays/scalars are not valid roots for either
# managed surface, because merging them would replace rather than preserve state.
function ConvertFrom-JsonObjectText {
    param(
        [Parameter(Mandatory)] [string] $Text,
        [Parameter(Mandatory)] [string] $Label
    )
    try { $value = $Text | ConvertFrom-Json -AsHashtable -ErrorAction Stop }
    catch { throw "$Label is invalid JSON: $($_.Exception.Message)" }
    if ($value -isnot [System.Collections.IDictionary]) {
        throw "$Label root is not a JSON object"
    }
    $value
}

# Follow a file symlink without requiring its target to exist yet. This keeps a
# create-time link intact and lets the managed transaction initialize its target.
function Resolve-JsonTargetPath {
    param([Parameter(Mandatory)] [string] $Path)

    $targetPath = $Path
    $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    while ($true) {
        $item = Get-Item -LiteralPath $targetPath -Force -ErrorAction SilentlyContinue
        if (-not $item -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) {
            return $targetPath
        }
        if (-not $seen.Add($item.FullName)) { throw "symbolic-link cycle while resolving $Path" }
        $resolved = $item.ResolveLinkTarget($false)
        if (-not $resolved) { throw "could not resolve link target for $Path" }
        $targetPath = $resolved.FullName
    }
}

# Read strict UTF-8 without normalizing the live bytes first. A single UTF-8 BOM
# is accepted for compatibility; successful writes normalize to BOM-free UTF-8.
function Read-JsonObject {
    param([Parameter(Mandatory)] [string] $Path)

    if (-not (Test-Path -LiteralPath $Path)) { return @{} }
    [byte[]] $bytes = [IO.File]::ReadAllBytes($Path)
    if ($bytes.Length -eq 0) { return @{} }

    $offset = 0
    if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {
        $offset = 3
    }
    try {
        $utf8 = [Text.UTF8Encoding]::new($false, $true)
        $text = $utf8.GetString($bytes, $offset, $bytes.Length - $offset)
    } catch {
        throw "$Path is not valid UTF-8: $($_.Exception.Message)"
    }
    if ([string]::IsNullOrWhiteSpace($text)) { return @{} }
    ConvertFrom-JsonObjectText -Text $text -Label $Path
}

# Recursive object merge: overlay leaves win; live-only/unknown leaves survive.
# settings.json opts into its special additive hook merge; HUD config does not.
function Merge-JsonObject {
    param(
        [Parameter(Mandatory)] [System.Collections.IDictionary] $Base,
        [Parameter(Mandatory)] [System.Collections.IDictionary] $Overlay
    )
    foreach ($key in $Overlay.Keys) {
        if ($Base.Contains($key) -and
            $Base[$key] -is [System.Collections.IDictionary] -and
            $Overlay[$key] -is [System.Collections.IDictionary]) {
            Merge-JsonObject -Base ($Base[$key]) -Overlay ($Overlay[$key])
        } else {
            $Base[$key] = $Overlay[$key]
        }
    }
}

# Additive per-event hook merge. Append only entries whose first hook command is
# not already present, preserving foreign live entries and forcing array shape.
function Merge-ClaudeHooks {
    param(
        [Parameter(Mandatory)] [System.Collections.IDictionary] $Base,
        [Parameter(Mandatory)] [System.Collections.IDictionary] $Overlay
    )
    foreach ($eventName in $Overlay.Keys) {
        $live = @()
        if ($null -ne $Base[$eventName]) { $live = @($Base[$eventName]) }
        $liveCommands = @($live | ForEach-Object { $_.hooks[0].command })
        $additions = @($Overlay[$eventName] | Where-Object {
            $command = $_.hooks[0].command
            (-not $command) -or ($liveCommands -notcontains $command)
        })
        $Base[$eventName] = @($live + $additions)
    }
}

# Serialize once, validate the candidate, then replace through a same-directory
# temporary file. Existing normalized bytes are left untouched for idempotence.
function Write-JsonObjectAtomically {
    param(
        [Parameter(Mandatory)] [string] $Path,
        [Parameter(Mandatory)] [System.Collections.IDictionary] $Value,
        [Parameter(Mandatory)] [bool] $ExpectedExists,
        [Parameter(Mandatory)] [AllowEmptyCollection()] [byte[]] $ExpectedBytes
    )

    $json = $Value | ConvertTo-Json -Depth 32 -ErrorAction Stop
    $json = $json.Replace("`r`n", "`n").Replace("`r", "`n").TrimEnd([char[]] "`r`n") + "`n"
    $utf8 = [Text.UTF8Encoding]::new($false, $true)
    [byte[]] $candidate = $utf8.GetBytes($json)

    $targetPath = Resolve-JsonTargetPath -Path $Path

    $directory = Split-Path -Parent $targetPath
    New-Item -ItemType Directory -Force -Path $directory -ErrorAction Stop | Out-Null
    $temporary = Join-Path $directory ('.' + [IO.Path]::GetFileName($targetPath) + '.tmp.' + [guid]::NewGuid().ToString('N'))
    $backup = "$temporary.backup"
    $guard = $null
    try {
        [IO.File]::WriteAllBytes($temporary, $candidate)
        $null = Read-JsonObject -Path $temporary

        $currentExists = Test-Path -LiteralPath $targetPath
        if ($currentExists -ne $ExpectedExists) {
            throw "$Path changed while the managed overlay was being prepared"
        }
        if ($currentExists) {
            # Deny ordinary readers/writers while allowing ReplaceFile's rename.
            # Compare through the held handle, then keep it open through the
            # atomic replacement so the precondition and commit share one guard.
            $guard = [IO.File]::Open($targetPath, [IO.FileMode]::Open,
                [IO.FileAccess]::Read, [IO.FileShare]::Delete)
            $stream = [IO.MemoryStream]::new()
            try {
                $guard.CopyTo($stream)
                [byte[]] $current = $stream.ToArray()
            } finally {
                $stream.Dispose()
            }
            if ([Convert]::ToBase64String($current) -cne [Convert]::ToBase64String($ExpectedBytes)) {
                throw "$Path changed while the managed overlay was being prepared"
            }
            if ($current.Length -eq $candidate.Length -and
                [Convert]::ToBase64String($current) -ceq [Convert]::ToBase64String($candidate)) {
                return $false
            }
            # ReplaceFile preserves the destination target's Windows ACLs and
            # attributes. A real backup path avoids null binding as an empty path.
            [IO.File]::Replace($temporary, $targetPath, $backup)
        } else {
            # Move without overwrite is a create-time precondition: a concurrent
            # creator makes this fail closed instead of losing the new file.
            [IO.File]::Move($temporary, $targetPath)
        }
    } finally {
        if ($guard) { $guard.Dispose() }
        Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue
        Remove-Item -LiteralPath $backup -Force -ErrorAction SilentlyContinue
    }
    $true
}

function Update-ClaudeSettings {
    param(
        [Parameter(Mandatory)] [string] $ClaudeDir,
        [Parameter(Mandatory)] [string] $OverlayJson
    )

    $overlay = ConvertFrom-JsonObjectText -Text $OverlayJson -Label 'managed Claude settings overlay'

    # Completion-feedback hooks are built here because the embedded JSON cannot
    # carry Go-template conditionals. notify = apprise toast; peon = voice lines.
    {{- $peon   := or (eq .agentSounds "peon")   (eq .agentSounds "both") }}
    {{- $notify := or (eq .agentSounds "notify") (eq .agentSounds "both") }}
    $notifyCommand = 'exec pwsh -NoProfile -File "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/notify.ps1"'
    $peonPs1 = Join-Path $HOME '.openpeon\hooks\peon-ping\peon.ps1'
    $peonCommand = "powershell -NoProfile -NonInteractive -Command `"if (Test-Path '$peonPs1') { & '$peonPs1' }`""
    $soundHooks = @{}
    {{- if $notify }}
    foreach ($eventName in @('Notification', 'Stop')) {
        $soundHooks[$eventName] = @(@{ matcher = ''; hooks = @(@{ type = 'command'; command = $notifyCommand }) })
    }
    {{- end }}
    {{- if $peon }}
    foreach ($eventName in @('SessionStart', 'SessionEnd', 'SubagentStart', 'Stop',
                              'Notification', 'PermissionRequest', 'PreToolUse',
                              'PostToolUseFailure', 'PreCompact')) {
        $entry = @{ matcher = ''; hooks = @(@{ type = 'command'; command = $peonCommand; timeout = 10 }) }
        if ($soundHooks.ContainsKey($eventName)) { $soundHooks[$eventName] = @($soundHooks[$eventName] + $entry) }
        else                                      { $soundHooks[$eventName] = @($entry) }
    }
    {{- end }}
    if ($soundHooks.Count -gt 0) {
        if ($overlay['hooks'] -isnot [System.Collections.IDictionary]) { $overlay['hooks'] = @{} }
        foreach ($eventName in $soundHooks.Keys) { $overlay['hooks'][$eventName] = $soundHooks[$eventName] }
    }

    # Prune only repository-owned hooks disabled by the current sound tier.
    $prunePatterns = @(
    {{- if not $notify }}
        'notify\.ps1'
    {{- end }}
    {{- if not $peon }}
        'peon\.ps1'
    {{- end }}
    )

    $settingsPath = Join-Path $ClaudeDir 'settings.json'
    $settingsTargetPath = Resolve-JsonTargetPath -Path $settingsPath
    $settingsExisted = Test-Path -LiteralPath $settingsTargetPath
    [byte[]] $settingsBytes = [byte[]]::new(0)
    if ($settingsExisted) { $settingsBytes = [IO.File]::ReadAllBytes($settingsTargetPath) }
    $settings = Read-JsonObject -Path $settingsTargetPath
    if ($overlay['hooks'] -is [System.Collections.IDictionary]) {
        if ($settings['hooks'] -isnot [System.Collections.IDictionary]) { $settings['hooks'] = @{} }
        Merge-ClaudeHooks -Base ($settings['hooks']) -Overlay ($overlay['hooks'])
        $overlay.Remove('hooks')
    }
    Merge-JsonObject -Base $settings -Overlay $overlay

    if ($prunePatterns.Count -gt 0 -and $settings['hooks'] -is [System.Collections.IDictionary]) {
        foreach ($eventName in @($settings['hooks'].Keys)) {
            $kept = @(@($settings['hooks'][$eventName]) | Where-Object {
                $command = $_.hooks[0].command
                if (-not $command) { return $true }
                foreach ($pattern in $prunePatterns) {
                    if ($command -match $pattern) { return $false }
                }
                $true
            })
            if ($kept.Count -gt 0) { $settings['hooks'][$eventName] = $kept }
            else                   { $settings['hooks'].Remove($eventName) }
        }
    }

    $changed = Write-JsonObjectAtomically -Path $settingsPath -Value $settings `
        -ExpectedExists $settingsExisted -ExpectedBytes $settingsBytes
    if ($changed) { Write-Host "claude overlay -> $settingsPath" }
}

function Update-ClaudeHudConfig {
    param(
        [Parameter(Mandatory)] [string] $ClaudeDir,
        [Parameter(Mandatory)] [string] $OverlayJson
    )

    $overlay = ConvertFrom-JsonObjectText -Text $OverlayJson -Label 'managed claude-hud Full 0.7.1 overlay'
    $hudPath = Join-Path $ClaudeDir 'plugins\claude-hud\config.json'
    $hudTargetPath = Resolve-JsonTargetPath -Path $hudPath
    $hudExisted = Test-Path -LiteralPath $hudTargetPath
    [byte[]] $hudBytes = [byte[]]::new(0)
    if ($hudExisted) { $hudBytes = [IO.File]::ReadAllBytes($hudTargetPath) }
    $config = Read-JsonObject -Path $hudTargetPath
    Merge-JsonObject -Base $config -Overlay $overlay
    $changed = Write-JsonObjectAtomically -Path $hudPath -Value $config `
        -ExpectedExists $hudExisted -ExpectedBytes $hudBytes
    if ($changed) { Write-Host "claude-hud Full overlay -> $hudPath" }
}

# Respect CLAUDE_CONFIG_DIR for both targets, matching Claude Code and claude-hud.
$claudeDir = if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { Join-Path $HOME '.claude' }
try { Update-ClaudeSettings -ClaudeDir $claudeDir -OverlayJson $settingsOverlayJson }
catch { Write-Warning "Claude settings overlay skipped; not overwriting: $($_.Exception.Message)" }
try { Update-ClaudeHudConfig -ClaudeDir $claudeDir -OverlayJson $hudOverlayJson }
catch { Write-Warning "claude-hud overlay skipped; not overwriting: $($_.Exception.Message)" }
{{ end -}}
