# herdr config, keybind helper scripts, herdr-plus plugin config and the
# herdr-aware tv channels are only deployed when the opt-in installHerdr toggle
# is on. The channels are gated too: without herdr they would show up in `tv`'s
# channel list and return nothing.
{{ if not .installHerdr }}
.config/herdr/**
AppData/Roaming/television/cable/herdr-*.toml
{{ end }}

# Clink profile (starship.lua for cmd.exe) is only deployed when the opt-in
# installClink toggle is on. The zoxide/fzf Clink bridges are fetched at apply
# time by the packages script, not managed here.
{{ if not .installClink }}
AppData/Local/clink/**
{{ end }}

# The translate history picker is only useful with the translate binary present
# (opt-in installTranslate). Without the gate it would show up in `tv`'s channel
# list and return nothing — same reasoning as the herdr-* channels above.
{{ if not .installTranslate }}
AppData/Roaming/television/cable/translate.toml
{{ end }}

# Rime user config is only deployed with the opt-in installInputMethod toggle.
# Weasel reads %APPDATA%\Rime; the runtime files it writes as siblings there
# (user.yaml, installation.yaml, build/, *.userdb/) are deliberately unmanaged —
# only *.custom.yaml is source of truth. Same policy as the parent repo.
{{ if not .installInputMethod }}
AppData/Roaming/Rime/**
{{ end }}
